// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum PlatformRole {
  USER
  SUPERADMIN
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  CANCELED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
}

enum TerminationType {
  RESIGNED
  TERMINATED
  CONTRACT_ENDED
  RETIRED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model User {
  userId             String       @id @default(cuid())
  email              String?      @unique @db.VarChar(191)
  name               String       @db.VarChar(191)
  passwordHash       String       @db.VarChar(255)
  mustChangePassword Boolean      @default(true)
  passwordChangedAt  DateTime?
  platformRole       PlatformRole @default(USER)
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  memberships           Membership[]
  terminatedMemberships Membership[]  @relation("MembershipTerminatedBy")
  sessions              UserSession[]
  createdCompanies      Company[]     @relation("CreatedByUser")

  @@map("users")
}

model Company {
  companyId String @id @default(cuid())
  name      String @db.VarChar(191)
  slug      String @unique @db.VarChar(100)

  email        String? @db.VarChar(191)
  phone        String? @db.VarChar(50)
  logoUrl      String? @db.VarChar(500)
  addressLine1 String? @db.VarChar(255)
  city         String? @db.VarChar(100)
  province     String? @db.VarChar(100)
  timezone     String? @db.VarChar(50)

  status          CompanyStatus @default(ACTIVE)
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  createdByUser User?          @relation("CreatedByUser", fields: [createdByUserId], references: [userId], onDelete: SetNull, onUpdate: Cascade)
  memberships   Membership[]
  roles         CompanyRole[]
  subscriptions Subscription[]
  departments   Department[]
  positions     Position[]
  locations     Location[]

  @@index([status])
  @@index([deletedAt])
  @@map("companies")
}

model Membership {
  membershipId String           @id @default(cuid())
  companyId    String
  userId       String
  loginId      String           @db.VarChar(100)
  status       MembershipStatus @default(ACTIVE)
  isOwner      Boolean          @default(false)
  joinedAt     DateTime         @default(now())
  lastLoginAt  DateTime?

  employmentEndedAt  DateTime?
  terminationType    TerminationType?
  terminationReason  String?          @db.Text
  terminatedByUserId String?
  accessRevokedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company             Company              @relation(fields: [companyId], references: [companyId], onDelete: Cascade, onUpdate: Cascade)
  user                User                 @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade)
  terminatedBy        User?                @relation("MembershipTerminatedBy", fields: [terminatedByUserId], references: [userId], onDelete: SetNull, onUpdate: Cascade)
  roles               MembershipRole[]
  sessions            UserSession[]
  employeeProfile     EmployeeProfile?
  employeeDepartments EmployeeDepartment[]
  employeePositions   EmployeePosition[]

  @@unique([companyId, userId])
  @@unique([companyId, loginId])
  @@index([companyId, status])
  @@index([userId, status])
  @@index([terminatedByUserId])
  @@map("memberships")
}

model Permission {
  permissionId String   @id @default(cuid())
  module       String   @db.VarChar(100)
  action       String   @db.VarChar(100)
  name         String   @db.VarChar(191)
  description  String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rolePermissions CompanyRolePermission[]

  @@unique([module, action])
  @@index([module])
  @@map("permissions")
}

model CompanyRole {
  companyRoleId String   @id @default(cuid())
  companyId     String
  name          String   @db.VarChar(191)
  description   String?  @db.Text
  isSystem      Boolean  @default(false)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company         Company                 @relation(fields: [companyId], references: [companyId], onDelete: Cascade, onUpdate: Cascade)
  rolePermissions CompanyRolePermission[]
  membershipRoles MembershipRole[]

  @@unique([companyId, name])
  @@index([companyId, isDefault])
  @@map("company_roles")
}

model CompanyRolePermission {
  companyRolePermissionId String   @id @default(cuid())
  roleId                  String
  permissionId            String
  createdAt               DateTime @default(now())

  role       CompanyRole @relation(fields: [roleId], references: [companyRoleId], onDelete: Cascade, onUpdate: Cascade)
  permission Permission  @relation(fields: [permissionId], references: [permissionId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("company_role_permissions")
}

model MembershipRole {
  membershipRoleId String   @id @default(cuid())
  membershipId     String
  roleId           String
  createdAt        DateTime @default(now())

  membership Membership  @relation(fields: [membershipId], references: [membershipId], onDelete: Cascade, onUpdate: Cascade)
  role       CompanyRole @relation(fields: [roleId], references: [companyRoleId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([membershipId, roleId])
  @@index([roleId])
  @@map("membership_roles")
}

model SubscriptionPlan {
  subscriptionPlanId String          @id @default(cuid())
  name               String          @db.VarChar(191)
  description        String?         @db.Text
  pricePerUser       Decimal         @db.Decimal(15, 2)
  currency           String          @default("IDR") @db.VarChar(10)
  interval           BillingInterval
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  subscriptions Subscription[]

  @@unique([name, interval])
  @@map("subscription_plans")
}

model Subscription {
  subscriptionId       String             @id @default(cuid())
  companyId            String
  planId               String
  status               SubscriptionStatus @default(TRIALING)
  seatLimit            Int
  pricePerUserSnapshot Decimal            @db.Decimal(15, 2)
  currencySnapshot     String             @default("IDR") @db.VarChar(10)
  startsAt             DateTime           @default(now())
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  canceledAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  company Company          @relation(fields: [companyId], references: [companyId], onDelete: Cascade, onUpdate: Cascade)
  plan    SubscriptionPlan @relation(fields: [planId], references: [subscriptionPlanId], onDelete: Restrict, onUpdate: Cascade)

  @@index([companyId, status])
  @@index([planId])
  @@map("subscriptions")
}

model UserSession {
  userSessionId    String        @id @default(cuid())
  userId           String
  membershipId     String?
  refreshTokenHash String        @unique @db.VarChar(255)
  deviceId         String?       @db.VarChar(191)
  deviceName       String?       @db.VarChar(100)
  platform         String?       @db.VarChar(50)
  ipAddress        String?       @db.VarChar(64)
  userAgent        String?       @db.VarChar(512)
  status           SessionStatus @default(ACTIVE)
  lastUsedAt       DateTime?
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?       @db.VarChar(255)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user       User        @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [membershipId], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, status])
  @@index([membershipId, status])
  @@map("user_sessions")
}

model EmployeeProfile {
  employeeProfileId String @id @default(cuid())
  membershipId      String @unique

  employeeNumber        String? @db.VarChar(100)
  phone                 String? @db.VarChar(50)
  emergencyContactName  String? @db.VarChar(191)
  emergencyContactPhone String? @db.VarChar(50)

  birthDate     DateTime? @db.Date
  birthPlace    String?   @db.VarChar(191)
  gender        String?   @db.VarChar(20)
  maritalStatus String?   @db.VarChar(50)

  addressLine1 String? @db.VarChar(255)
  city         String? @db.VarChar(100)
  province     String? @db.VarChar(100)

  employmentType   String?   @db.VarChar(50)
  hireDate         DateTime? @db.Date
  probationEndDate DateTime? @db.Date

  photoUrl String? @db.VarChar(500)
  notes    String? @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  membership Membership @relation(fields: [membershipId], references: [membershipId], onDelete: Cascade, onUpdate: Cascade)

  @@index([employeeNumber])
  @@index([hireDate])
  @@index([deletedAt])
  @@map("employee_profiles")
}

model Department {
  departmentId String    @id @default(cuid())
  companyId    String
  name         String    @db.VarChar(191)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  company       Company              @relation(fields: [companyId], references: [companyId], onDelete: Cascade, onUpdate: Cascade)
  employeeLinks EmployeeDepartment[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@index([deletedAt])
  @@map("departments")
}

model Position {
  positionId String    @id @default(cuid())
  companyId  String
  name       String    @db.VarChar(191)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  company       Company            @relation(fields: [companyId], references: [companyId], onDelete: Cascade, onUpdate: Cascade)
  employeeLinks EmployeePosition[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@index([deletedAt])
  @@map("positions")
}

model Location {
  locationId   String    @id @default(cuid())
  companyId    String
  name         String    @db.VarChar(191)
  addressLine1 String?   @db.VarChar(255)
  city         String?   @db.VarChar(100)
  province     String?   @db.VarChar(100)
  timezone     String?   @db.VarChar(50)
  latitude     Decimal?  @db.Decimal(10, 6)
  longitude    Decimal?  @db.Decimal(10, 6)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  company Company @relation(fields: [companyId], references: [companyId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@index([deletedAt])
  @@map("locations")
}

model EmployeeDepartment {
  employeeDepartmentId String   @id @default(cuid())
  membershipId         String
  departmentId         String
  isPrimary            Boolean  @default(true)
  createdAt            DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [membershipId], onDelete: Cascade, onUpdate: Cascade)
  department Department @relation(fields: [departmentId], references: [departmentId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([membershipId, departmentId])
  @@index([departmentId])
  @@map("employee_departments")
}

model EmployeePosition {
  employeePositionId String   @id @default(cuid())
  membershipId       String
  positionId         String
  isPrimary          Boolean  @default(true)
  createdAt          DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [membershipId], onDelete: Cascade, onUpdate: Cascade)
  position   Position   @relation(fields: [positionId], references: [positionId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([membershipId, positionId])
  @@index([positionId])
  @@map("employee_positions")
}
